# Copy to .env.local for local development. Never commit real values.
# Base URL of the FastAPI backend (defaults to http://localhost:8000 if unset).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Google sign-in: the same OAuth Web client ID as GOOGLE_CLIENT_ID in the backend. Leave empty to hide the button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=337021619628-6h3jrdqmlmrgbo7fde3pufoef0jjslem.apps.googleusercontent.com
# The storefront app (theme editor: theme definitions and the preview). Local: http://localhost:3001
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3001

# Where the POS release workflow publishes latest.json / index.json (the /download page reads them, server side)
POS_RELEASES_URL=https://pub-93266581084048e6848fe333150dc91f.r2.dev/releases/pos
